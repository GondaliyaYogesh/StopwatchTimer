<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <TextView
        android:layout_height="wrap_content"
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:text="Stopwatch"
        android:background="#5DACCA"
        android:textSize="30sp"
        android:paddingVertical="15dp"
        android:paddingStart="10dp"
        android:textColor="@color/black"
        android:fontFamily="@font/ubuntu_medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal">
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:text="Stopwatch"
            android:background="#5DACCA"
            android:layout_weight="1"
            android:textSize="30sp"
            android:paddingVertical="15dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColor="@color/black"
            android:fontFamily="@font/ubuntu_medium"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Timer"

            android:background="#5DACCA"
            android:textSize="30sp"
            android:layout_weight="1"
            android:paddingVertical="15dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColor="@color/black"
            android:fontFamily="@font/ubuntu_medium"
            />



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/Stopwatch"
            android:paddingVertical="20dp"
            android:paddingStart="10dp"
            android:alpha="0"
            android:paddingEnd="0dp"
            android:layout_weight="1"
            android:enabled="false"/>
        <Button
            android:layout_width="0dp"
            android:alpha="0"
            android:layout_height="wrap_content"
            android:id="@+id/Timer"
            android:paddingVertical="20dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:layout_weight="1"/>

    </LinearLayout>
    <!--start,stop,reset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintBottom_toTopOf="@+id/bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal">
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:textAlignment="center"
            android:text="Start"
            android:background="@color/black"
            android:layout_weight="1"
            android:textSize="30sp"
            android:paddingVertical="15dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColor="#5DACCA"
            android:fontFamily="@font/ubuntu_medium"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:textAlignment="center"
            android:text="Pause"
            android:background="@color/black"
            android:layout_weight="1"
            android:textSize="30sp"
            android:paddingVertical="15dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColor="#5DACCA"
            android:fontFamily="@font/ubuntu_medium"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textAlignment="center"
            android:background="@color/black"
            android:textSize="30sp"
            android:layout_weight="1"
            android:paddingVertical="15dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColor="#5DACCA"
            android:fontFamily="@font/ubuntu_medium"
            />



    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        >
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/Start"
            android:paddingVertical="20dp"
            android:paddingStart="10dp"
            android:alpha="0"
            android:paddingEnd="0dp"
            android:layout_weight="1"/>
        <Button
            android:layout_width="0dp"
            android:alpha="0"
            android:layout_height="wrap_content"
            android:id="@+id/Pause"
            android:paddingVertical="20dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:layout_weight="1"/>
        <Button
            android:layout_width="0dp"
            android:alpha="0"
            android:layout_height="wrap_content"
            android:id="@+id/Reset"
            android:paddingVertical="20dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:layout_weight="1"/>

    </LinearLayout>


    <!-- time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar"

        android:paddingTop="25dp"

        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/back"
            >

            <TextView
                android:id="@+id/minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:textColor="#5DACCA"
                android:textSize="100dp"
                android:fontFamily="@font/digital"


                android:text="00"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/colon1"

                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintRight_toLeftOf="@+id/colon1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/colon1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/digital"


                android:text=":"

                android:textColor="#5dacca"
                android:textSize="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/second"

                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintRight_toLeftOf="@+id/second"

                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/digital"

                android:text="00"
                android:textColor="#5dacca"
                android:textSize="100dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/colon2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/digital"


                android:text=":"
                android:textColor="#5dacca"
                android:textSize="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/second"

                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintLeft_toRightOf="@+id/second"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/milisecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/digital"


                android:text="00"
                android:textColor="#5dacca"
                android:textSize="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/colon2"

                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintLeft_toRightOf="@+id/colon2"
                app:layout_constraintTop_toTopOf="parent"   />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>